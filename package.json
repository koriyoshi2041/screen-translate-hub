{
  "name": "screen-translate-hub",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tools/dev"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.ts\" \"services/*/test/*.test.ts\"",
    "test:py": ".venv\\Scripts\\python -m unittest discover -s services/py -p \"test_*.py\" -t services/py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
